# Copy this file to ".env" (same folder) and fill it in. Real environment variables win over this file.
# Never commit ".env": it holds secrets.

# How people get in:
#   password  everyone types their name and one shared password (SITE_PASSWORD)
#   google    Google accounts on an allow list (needs a public https address, see DEPLOY.md)
#   (leave out) everyone gets in, for local use only
AUTH_MODE=password

# --- password mode
SITE_PASSWORD=

# --- google mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address people use from outside, e.g. https://boards.example.com
PUBLIC_URL=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Optional. Only listen on this machine, so a tunnel is the only way in. Default is all interfaces.
# HOST=127.0.0.1
