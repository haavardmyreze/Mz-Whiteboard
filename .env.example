# Copy this file to ".env" (same folder) and fill it in. Real environment variables win over this file.
# Never commit ".env": it holds a secret.

# Sign in with Google accounts from an allow list. Leave AUTH_MODE out to let everyone in (local use only).
AUTH_MODE=google

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Authorised redirect URI there must be exactly: <PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The address people use to reach this tool from outside, e.g. https://boards.example.com
# (http://localhost:4680 works for trying it out on this PC.)
PUBLIC_URL=

# Who may sign in: any mix of exact emails and whole domains, comma separated.
ALLOWED_EMAILS=haavard.vikesland@gmail.com
ALLOWED_DOMAINS=

# Optional. Only listen on this machine, so the tunnel is the only way in. Default is all interfaces.
# HOST=127.0.0.1
